# Copiar este fichero como ".env" (el .env NO se sube a GitHub):   cp .env.example .env
# Formato: VARIABLE=valor, sin espacios ni comillas; los comentarios en su propia línea.
#
# <IP_EC2> = IP pública de la EC2 (consola de AWS > EC2 > Instancias > "Dirección IPv4 pública").
# En el Learner Lab CAMBIA cada vez que se arranca el laboratorio: revisarla antes de cada sesión.

# ---------------------------------------------------------------------------------------------
# PCs del LABORATORIO (lo leen docker-compose.ws.yml y docker-compose.fo.yml)
# ---------------------------------------------------------------------------------------------
# Kafka de la EC2 (puerta EXTERNAL de docker-compose.cloud.yml)
KAFKA_BROKER=16.16.160.32:9092

# Sockets de WM_Central en la EC2 (los Monitor de las WS se conectan aquí)
CENTRAL=16.16.160.32:5050

# ---------------------------------------------------------------------------------------------
# EC2 (lo lee docker-compose.cloud.yml). deploy/deploy_ec2.sh rellena PUBLIC_IP solo.
# ---------------------------------------------------------------------------------------------
PUBLIC_IP=16.16.160.32
# Opcionales (puertos publicados en la EC2; si se cambian, abrirlos también en el security group)
# KAFKA_PORT=9092
# CENTRAL_PORT=5050
# PANEL_PORT=8080
