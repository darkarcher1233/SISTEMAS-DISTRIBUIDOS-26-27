# Copiar este fichero como ".env" (el .env NO se sube a GitHub):   cp .env.example .env
# Lo leen docker-compose.ws.yml y docker-compose.fo.yml (laboratorio).
# Formato: VARIABLE=valor, sin espacios ni comillas; los comentarios en su propia línea.

# Kafka en AWS (EC2, contenedor bitnami). Debe anunciar esta misma IP pública
# (advertised.listeners), no localhost.
KAFKA_BROKER=51.20.108.192:9092

# WM_Central (host:puerto) tal como lo ven los CONTENEDORES.
#   - Central en este mismo PC (Windows/Mac con Docker Desktop):  host.docker.internal:5050
#   - Central en otro PC del laboratorio:                         <IP_de_ese_PC>:5050
#   - Más adelante, Central en AWS:                               <IP_publica_Central_AWS>:<puerto>
CENTRAL=host.docker.internal:5050
